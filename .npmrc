# Blockly 13 declares jsdom as a peer dependency, and npm 10 currently fails with an internal
# error while resolving jsdom's optional `canvas` peer. jsdom is listed explicitly in
# devDependencies, so legacy peer resolution does not change what is installed.
legacy-peer-deps=true
audit=false
fund=false
# Electron downloads its binary from GitHub release assets during install. Environments without
# access to that host (for example some CI sandboxes) should set ELECTRON_SKIP_BINARY_DOWNLOAD=1.
